{
  "id": "root",
  "cloned_from": {
    "name": "estro",
    "version": "0.1.16"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "sidebar-lists",
          "type": "block",
          "content": {
            "mod": "better-sidebar-refined",
            "props": {
              "view": "lists",
              "minimalChrome": true,
              "refinedChrome": true
            }
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "better-sidebar-refined",
            "props": {
              "view": "footer",
              "refinedChrome": true
            }
          },
          "size": {
            "px": 28
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 560,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "better-tabs-refined",
                "props": {
                  "rememberPanels": {
                    "container": "panel",
                    "stack": "panel-body"
                  },
                  "buttons": [
                    {
                      "id": "files",
                      "label": "Files",
                      "icon": "file",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "label": "Changes",
                      "icon": "changes",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "changes"
                      }
                    },
                    {
                      "id": "merge-requests",
                      "label": "MRs",
                      "tooltip": "Merge and pull requests",
                      "icon": "mods/better-sidebar-refined/icons/pull-request.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "merge-requests"
                      }
                    },
                    {
                      "id": "automations",
                      "label": "Automations",
                      "icon": "mods/automations-refined/automations.svg",
                      "group": "panels",
                      "action": {
                        "type": "panel",
                        "container": "panel",
                        "stack": "panel-body",
                        "target": "automations"
                      }
                    }
                  ],
                  "mode": "workspace-tabs",
                  "refinedChrome": true
                }
              },
              "size": {
                "weight": 1
              },
              "window_drag": true
            }
          ],
          "size": {
            "px": 44
          },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "workspace-content",
              "type": "stack",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "linked-pane-refined"
                        },
                        "reveal": "always",
                        "height": 32,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "border"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "workspace-empty",
                  "type": "block",
                  "content": {
                    "mod": "better-tabs-refined",
                    "props": {
                      "mode": "empty-workspace"
                    }
                  }
                },
                {
                  "id": "workspace-split",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "linked-pane-refined"
                        },
                        "reveal": "always",
                        "height": 32,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                }
              ],
              "active": "main"
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "workspace-footer",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "background": "chrome",
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "session-hub-service",
              "type": "block",
              "content": {
                "mod": "session-hub-refined",
                "props": {
                  "view": "service"
                }
              },
              "size": {
                "px": 1
              },
              "resizable": false
            },
            {
              "id": "task-spaces-service",
              "type": "block",
              "content": {
                "mod": "task-spaces-refined",
                "props": {
                  "view": "service"
                }
              },
              "size": {
                "px": 1
              },
              "resizable": false
            },
            {
              "id": "merge-requests-service",
              "type": "block",
              "content": {
                "mod": "better-sidebar-refined",
                "props": {
                  "view": "merge-requests-service"
                }
              },
              "size": {
                "px": 1
              },
              "resizable": false
            },
            {
              "id": "panel-toggle",
              "type": "block",
              "content": {
                "mod": "better-sidebar-refined",
                "props": {
                  "view": "panel-toggle",
                  "keyOnly": true
                }
              },
              "size": {
                "px": 1
              },
              "resizable": false
            }
          ]
        }
      ],
      "resizable": false
    },
    {
      "id": "panel",
      "type": "column",
      "children": [
        {
          "id": "panel-toolbar",
          "type": "block",
          "content": {
            "mod": "better-tabs-refined",
            "props": {
              "rememberPanels": false,
              "buttons": [
                {
                  "id": "files",
                  "label": "Files",
                  "icon": "file",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "files"
                  }
                },
                {
                  "id": "changes",
                  "label": "Changes",
                  "icon": "changes",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "changes"
                  }
                },
                {
                  "id": "merge-requests",
                  "label": "MRs",
                  "tooltip": "Merge and pull requests",
                  "icon": "mods/better-sidebar-refined/icons/pull-request.svg",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "merge-requests"
                  }
                },
                {
                  "id": "automations",
                  "label": "Automations",
                  "icon": "mods/automations-refined/automations.svg",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "automations"
                  }
                }
              ],
              "mode": "panel-toolbar",
              "refinedChrome": true
            }
          },
          "size": {
            "px": 44
          },
          "resizable": false
        },
        {
          "id": "panel-inset",
          "type": "row",
          "resizable": false,
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "linked-files-refined"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "linked-changes-refined"
                  }
                },
                {
                  "id": "merge-requests",
                  "type": "block",
                  "content": {
                    "mod": "better-sidebar-refined",
                    "props": {
                      "view": "merge-requests"
                    }
                  }
                },
                {
                  "id": "automations",
                  "type": "block",
                  "content": {
                    "mod": "automations-refined"
                  }
                }
              ],
              "active": "changes",
              "padding": [
                8,
                0
              ]
            },
            {
              "id": "panel-gutter",
              "type": "block",
              "size": {
                "px": 8
              },
              "resizable": false,
              "content": {
                "mod": "better-tabs-refined",
                "props": {
                  "mode": "panel-gutter"
                }
              }
            }
          ]
        },
        {
          "id": "panel-footer",
          "type": "block",
          "content": {
            "mod": "better-tabs-refined",
            "props": {
              "mode": "panel-footer"
            }
          },
          "size": {
            "px": 28
          },
          "resizable": false
        }
      ],
      "size": {
        "px": 368
      },
      "min": 280,
      "max": 900
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "canvas"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
